# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Copy to .env and fill with THROWAWAY test-workspace credentials only.
# Real secrets live only on the host, never in the working tree.
# Provisional: names are confirmed in Phase 1 (R4) and Phase 3.

# --- Slack (Bolt for JavaScript, Socket Mode) ---
# Bot token (xoxb-...) from the app's OAuth & Permissions page.
SLACK_BOT_TOKEN=
# App-level token (xapp-...) with the connections:write scope; Socket Mode needs it.
SLACK_APP_TOKEN=
# Team ID of the one workspace this bridge serves (used in xid derivation).
SLACK_TEAM_ID=

# --- Pol.is ---
# Public origin of the self-hosted Pol.is, same registrable domain as the bridge.
POLIS_ORIGIN=https://polis.example.test
# How the bridge admits xids (decided in R2). Placeholder for a restricted DB role.
POLIS_ADMIN_DATABASE_URL=

# --- Bridge web server ---
BRIDGE_ORIGIN=https://vote.example.test
BRIDGE_PORT=3000
# Directory for the SQLite store. Backed up.
BRIDGE_DATA_DIR=./data
# Directory for per-round keys. NEVER backed up (CLAUDE.md, privacy floor).
BRIDGE_KEY_DIR=./secrets/round-keys

# --- Logging ---
# warn in production; payloads, tokens and query strings are never logged.
LOG_LEVEL=warn
